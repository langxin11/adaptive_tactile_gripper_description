        <geometry><mesh filename="package://adaptive_tactile_gripper_description/meshes/finger_brace.stl"/></geometry>
        <material name="${ns}_pla_cf_structure__finger_brace"><color rgba="0.87058824 0.31372549 0.14117647 1"/></material>
      </visual>
      <collision name="${ns}_right_mgn9_block_back_collision">
        <origin xyz="0 0.00050000006 ${0.01445 + (-0.5) * safety_distance}" rpy="0 0 0"/>
        <geometry><box size="${0.020002 + 2 * safety_distance} ${0.0080019996 + 2 * safety_distance} ${0.028902 + 1 * safety_distance}"/></geometry>
