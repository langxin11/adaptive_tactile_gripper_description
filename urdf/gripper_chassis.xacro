      <visual>
        <origin xyz="0 -0.0035 0.01445" rpy="1.57079632679 -1.57079632679 0"/>
        <geometry><mesh filename="package://adaptive_tactile_gripper_description/meshes/finger_mount.stl"/></geometry>
        <material name="${ns}_pla_cf_structure"><color rgba="0.14117647 0.26666667 0.62352941 1"/></material>
