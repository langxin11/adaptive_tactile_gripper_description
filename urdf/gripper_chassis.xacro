        <geometry><box size="${0.034002002 + 2 * safety_distance} ${0.033499606 + 2 * safety_distance} ${0.03088419 + 1 * safety_distance}"/></geometry>
      </collision>
    </link>
    <joint name="${ns}_left_sensor_mount_joint" type="fixed">
